# PostgreSQL / PostgREST
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=cda_busqueda

# Scraper and scheduler DB connection inside Docker Compose
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cda_busqueda
DB_USER=postgres
DB_PASSWORD=mysecretpassword

# Browser-facing URLs used by the frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional S3 uploads for scraper assets.
# Leave disabled until AWS credentials and bucket are ready.
S3_UPLOAD_ENABLED=false
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
